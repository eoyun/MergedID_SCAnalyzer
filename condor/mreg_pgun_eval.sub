universe                = vanilla
executable              = condor/run_mreg_pgun_eval.sh
arguments               = $(arguments)
MY.SendCredential       = True
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = eval_pgun.py, multitask_common.py, train_resnet_image_classifier.py, train_fusion_cross_attention.py, track_point_transformer.py, train_point_transformer_track_classifier.py, train_fusion_ensemble.py, build_event_level_weights.py, pipeline
transfer_output_files   = ""
output = condor/logs/mreg_pgun_eval/p.$(Cluster).$(Process).out
error  = condor/logs/mreg_pgun_eval/p.$(Cluster).$(Process).err
log    = condor/logs/mreg_pgun_eval/p.$(Cluster).$(Process).log
request_cpus   = 4
request_memory = 16 GB
request_disk   = 8 GB
request_gpus   = 1
require_gpus   = (Capability >= 8.0)
max_retries    = 3
+JobFlavour = "longlunch"

queue arguments from condor/mreg_pgun_eval.txt
