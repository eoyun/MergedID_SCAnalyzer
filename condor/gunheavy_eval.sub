universe                = vanilla
executable              = condor/run_gunheavy_eval.sh
arguments               = $(arguments)
MY.SendCredential       = True
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = eval_gunheavy.py, multitask_common.py, train_fusion_cross_attention.py, train_resnet_image_classifier.py, track_point_transformer.py, train_point_transformer_track_classifier.py, train_fusion_ensemble.py, build_event_level_weights.py, pipeline
transfer_output_files   = ""
output = condor/logs/gunheavy_eval/e.$(Cluster).$(Process).out
error  = condor/logs/gunheavy_eval/e.$(Cluster).$(Process).err
log    = condor/logs/gunheavy_eval/e.$(Cluster).$(Process).log
request_cpus   = 8
request_memory = 24 GB
request_disk   = 16 GB
request_gpus   = 1
require_gpus   = (Capability >= 8.0)
max_retries    = 3
+JobFlavour = "nextweek"
queue arguments from condor/gunheavy_eval.txt
